# Copy to ops/runtime.env. Secret files must be supplied through your secret manager.
DATABASE_URL_FILE=/run/secrets/database-url
WORKER_DATABASE_URL_FILE=/run/secrets/worker-database-url
ENCRYPTION_KEY_FILE=/run/secrets/encryption-key
S3_ACCESS_KEY_FILE=/run/secrets/s3-access-key
S3_SECRET_KEY_FILE=/run/secrets/s3-secret
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=us-east-1
S3_BUCKET=insurance-private
NATS_URL=tls://nats.example.invalid:4222
NATS_TOKEN_FILE=/run/secrets/nats-token
TEMPORAL_ADDRESS=temporal.example.invalid:7233
TEMPORAL_NAMESPACE=insurance
TEMPORAL_CA_FILE=/run/secrets/temporal-ca
TEMPORAL_CLIENT_CERT_FILE=/run/secrets/temporal-client-cert
TEMPORAL_CLIENT_KEY_FILE=/run/secrets/temporal-client-key
# Live provider endpoints/credentials belong to independently approved adapter versions.
ALLOWED_ORIGINS=https://cover.example.invalid,https://partners.example.invalid,https://admin.example.invalid,https://developers.example.invalid
WEBHOOK_ALLOWED_HOSTS=approved-customer.example.invalid
CLAMAV_HOST=scanner.internal
# Configure the managed scanner's timezone as UTC. Stale definitions stay quarantined.
# This is an operational target, configurable from 1 to 168 hours.
CLAMAV_MAX_SIGNATURE_AGE_HOURS=72

PROVIDER_ALLOWED_HOSTS=certified-adapter.example.invalid
